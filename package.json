{
  "name": "kryptox-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:android": "CAPACITOR_BUILD=true next build && npx cap sync android && npx cap open android",
    "build:android:win": "set CAPACITOR_BUILD=true && next build && npx cap sync android && npx cap open android",
    "build:ios": "CAPACITOR_BUILD=true next build && npx cap sync ios && npx cap open ios",
    "dev:android": "CAPACITOR_DEV_SERVER_URL=http://192.168.1.X:3000 npx cap run android",
    "cap:setup": "npx cap init && npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:update": "npx cap update"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/camera": "^6.0.0",
    "@capacitor/clipboard": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "framer-motion": "^11.0.8",
    "html5-qrcode": "^2.3.8",
    "i18next": "^23.10.0",
    "next": "14.1.4",
    "qrcode": "^1.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.0.8",
    "recharts": "^2.12.3",
    "socket.io-client": "^4.7.5",
    "lucide-react": "^0.383.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@types/node": "^20.11.28",
    "@types/react": "^18.2.66",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.1.4",
    "postcss": "^8.4.36",
    "tailwindcss": "^3.4.1"
  }
}